# Comma-separated list of allowed origins for CORS
# In production (Render), set this to your Vercel frontend URL
ALLOWED_ORIGINS=*

# Path to drivers_v2.json (optional, auto-detected if in backend/ directory)
# DRIVERS_JSON=./drivers_v2.json

# Path to embeddings.json (optional, auto-detected if in backend/ directory)
# EMBEDDINGS_JSON=./embeddings.json
