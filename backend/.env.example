# Comma-separated list of allowed origins for CORS
# In production (Render), set this to your Vercel frontend URL
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=*

# Path to drivers_v2.json (optional, auto-detected if in backend/ directory)
# DRIVERS_JSON=./drivers_v2.json

# Path to sentence-transformer model (optional, auto-detected or falls back to all-MiniLM-L6-v2)
# MODEL_PATH=./f1_finetuned_model
