# Hugging Face Inference API token (get one at https://huggingface.co/settings/tokens)
# Free tier works, but rate-limited without a token
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use (default: sentence-transformers/all-MiniLM-L6-v2)
# HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Comma-separated list of allowed origins for CORS
# In production (Render), set this to your Vercel frontend URL
ALLOWED_ORIGINS=*

# Path to drivers_v2.json (optional, auto-detected if in backend/ directory)
# DRIVERS_JSON=./drivers_v2.json
